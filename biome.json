{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["src/**", "scripts/**"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			},
			"style": {
				"useTemplate": "error",
				"useNodejsImportProtocol": "error",
				"noNonNullAssertion": "error",
				"noParameterAssign": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noDoubleEquals": "error",
				"noSelfCompare": "error",
				"noEmptyBlockStatements": "error"
			},
			"complexity": {
				"useSimplifiedLogicExpression": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "all"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"src/core/**/*.ts",
				"!src/core/**/*.test.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"fs": "Keep core transformations pure; move filesystem access to src/io/.",
									"fs/promises": "Keep core transformations pure; move filesystem access to src/io/.",
									"node:fs": "Keep core transformations pure; move filesystem access to src/io/.",
									"node:fs/promises": "Keep core transformations pure; move filesystem access to src/io/."
								}
							}
						}
					}
				}
			}
		}
	]
}
